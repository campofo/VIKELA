# Copy to .env and adjust for your deployment.

# --- Local (uvicorn) runs -------------------------------------------------
# Path to the SQLite database file. Relative paths resolve against the process
# working directory. The parent directory is created automatically on startup.
# NOTE: docker compose overrides this to /data/vikela.db (the mounted volume).
VIKELA_DB_PATH=vikela.db

# --- Docker compose deployment (VPS) --------------------------------------
# Public plain-HTTP bind for the published port. The SIM7000G hardware POSTs
# here directly over HTTP (no TLS). Open this port in the VPS firewall. If the
# mobile carrier blocks 8081, switch to 0.0.0.0:80.
VIKELA_BIND=0.0.0.0:8081

# Allowed CORS origins (comma-separated), or * for any. Tighten to your app /
# dashboard origins in production.
VIKELA_CORS_ORIGINS=*
