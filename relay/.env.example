# Copy to .env and adjust for your deployment.

# The Firebase Cloud Function the relay forwards alerts to (over HTTPS).
FIREBASE_FUNCTION_URL=https://europe-west1-dara-cd3e8.cloudfunctions.net/hardwareAlert

# Public plain-HTTP bind for the device to reach. Open this port in the VPS
# firewall. If the mobile carrier blocks 8081, switch to 0.0.0.0:80.
RELAY_BIND=0.0.0.0:8081

# Seconds to wait for Firebase before returning 502 to the device.
RELAY_FORWARD_TIMEOUT=30
